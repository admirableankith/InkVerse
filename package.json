{
  "name": "discoverwithankur",
  "version": "1.0.0",
  "description": "Clean, modern, simple personal blogging website for Ankur",
  "main": "server/index.js",
  "scripts": {
    "start": "node server/index.js",
    "server": "nodemon server/index.js",
    "client": "npm run dev --prefix client",
    "dev": "concurrently -n \"SERVER,CLIENT\" -c \"blue,magenta\" \"nodemon server/index.js\" \"npm run dev --prefix client\"",
    "build": "npm install --prefix client && npm run build --prefix client",
    "create-admin": "node server/scripts/createAdmin.js",
    "migrate-to-mongo": "node server/scripts/migrateToMongo.js"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "keywords": [
    "blog",
    "personal-website",
    "student-writer",
    "react",
    "express",
    "tailwind"
  ],
  "author": "Ankur",
  "license": "ISC",
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cloudinary": "^2.11.0",
    "concurrently": "^9.1.2",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "express-rate-limit": "^8.7.0",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.9.5",
    "multer": "^1.4.5-lts.1",
    "nodemailer": "^10.0.14"
  },
  "devDependencies": {
    "nodemon": "^3.1.9"
  }
}
